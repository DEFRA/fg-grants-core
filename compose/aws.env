AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# maxReceiveCount applied to every queue's redrive policy in start-localstack.sh.
# Default 1 (one failed receive dead-letters).
# Set to 2 to give headroom for peeking queues without instantly dead-lettering,
# then recreate the queues.
MAX_READS=1
